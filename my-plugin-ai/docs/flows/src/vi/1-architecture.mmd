flowchart TB
  Merchant(["Chủ shop"])
  Shopper(["Khách hàng"])

  subgraph Shopify["Nền tảng Shopify"]
    direction LR
    Admin["Shopify Admin"]
    Store["Cửa hàng online (theme Horizon)<br/>+ widget gợi ý"]
    Proxy["App Proxy<br/>/apps/ai/recommend"]
    API["Admin GraphQL API<br/>+ webhook đơn hàng"]
  end

  subgraph App["Server SmartCart RCM (Node.js, React Router)"]
