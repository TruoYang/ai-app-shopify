    DB[("SQLite (Prisma)<br/>đơn hàng · luật · bảng khớp CSV · cài đặt")]
    ML["Bộ huấn luyện Python<br/>FP-Growth · Item-kNN · DEC · Hybrid"]
  end

  Merchant --> Admin
  Shopper --> Store
  Admin -- "token phiên App Bridge" --> UI
