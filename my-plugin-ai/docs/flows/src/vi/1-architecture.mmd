    UI["Giao diện quản trị nhúng<br/>Trang chủ · Rules · Data"]
    Import["Import CSV<br/>+ khớp sản phẩm"]
    Train["Dịch vụ huấn luyện<br/>+ lịch hàng tuần / hàng tháng"]
    Rec["API gợi ý<br/>(đọc danh mục sản phẩm)"]
    Hook["Xử lý webhook đơn hàng"]
  end

  subgraph Data["Dữ liệu và học máy"]
